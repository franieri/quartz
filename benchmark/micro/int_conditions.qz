import system.io as io;
// @benchmark: name="Integer Conditions" iterations=200000 category="micro"
// Tests evalCondition fast-path for int type (truthy check)

let x = 1;
let count = 0;
let i = 0;
while (i < 200000) {
    if (x) {
        count = count + 1;
    }
    if (i > 100000) {
        x = 0;
    } else {
        x = 1;
    }
    i = i + 1;
}
io.out.println(count);
