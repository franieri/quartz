import system.io as io;
// @benchmark: name="Accumulator Pattern" iterations=100000 category="realworld"
// Common accumulator pattern found in data processing

fn process_value(acc, val) {
    let new_sum = acc + val;
    let new_count = acc + 1;
    return new_sum;
}

fn compute_average(values_sum, count) {
    if (count == 0) { return 0; }
    return values_sum / count;
}

let sum = 0;
let count = 0;
let i = 0;
while (i < 100000) {
    sum = process_value(sum, i);
    count = count + 1;
    i = i + 1;
}

let avg = compute_average(sum, count);
io.out.println(avg);
