import system.io as io;
// @benchmark: name="Local Variables" iterations=200000 category="memory"
// Tests local variable allocation in functions

fn many_locals(a, b, c) {
    let x1 = a + 1;
    let x2 = b + 2;
    let x3 = c + 3;
    let x4 = x1 + x2;
    let x5 = x2 + x3;
    let x6 = x4 + x5;
    return x6;
}

let sum = 0;
let i = 0;
while (i < 200000) {
    sum = sum + many_locals(1, 2, 3);
    i = i + 1;
}
io.out.println(sum);
