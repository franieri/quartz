import system.io as io;
// @benchmark: name="Validation Chain" iterations=50000 category="realworld"
// Multiple validation checks - common in business logic

fn validate_range(val, min, max) {
    return val >= min && val <= max;
}

fn validate_positive(val) {
    return val > 0;
}

fn validate_even(val) {
    return val / 2 * 2 == val;
}

fn validate_all(val) {
    if (!validate_positive(val)) { return false; }
    if (!validate_range(val, 1, 1000000)) { return false; }
    return true;
}

let valid_count = 0;
let i = 1;
while (i < 50000) {
    if (validate_all(i)) {
        valid_count = valid_count + 1;
    }
    i = i + 1;
}
io.out.println(valid_count);
