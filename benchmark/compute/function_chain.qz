import system.io as io;
// @benchmark: name="Function Call Chain" iterations=100000 category="compute"
// Tests function call overhead with multiple chained calls

fn add(a, b) {
    return a + b;
}

fn multiply(a, b) {
    return a * b;
}

fn compute(x) {
    return add(multiply(x, 2), 1);
}

let result = 0;
let i = 0;
while (i < 100000) {
    result = compute(i);
    i = i + 1;
}
io.out.println(result);
