import system.io as io;
// @benchmark: name="Triple Nested Loops" iterations=125000 category="compute"
// Triple nested loop stress test

let total = 0;
let i = 0;
while (i < 50) {
    let j = 0;
    while (j < 50) {
        let k = 0;
        while (k < 50) {
            total = total + 1;
            k = k + 1;
        }
        j = j + 1;
    }
    i = i + 1;
}
io.out.println(total);
