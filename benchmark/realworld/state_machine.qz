import system.io as io;
// @benchmark: name="State Machine" iterations=100000 category="realworld"
// Simple state machine pattern

fn transition(state, input) {
    if (state == 0) {
        if (input > 50) { return 1; }
        return 0;
    }
    if (state == 1) {
        if (input < 25) { return 2; }
        if (input > 75) { return 0; }
        return 1;
    }
    if (state == 2) {
        if (input > 50) { return 0; }
        return 2;
    }
    return 0;
}

let state = 0;
let transitions = 0;
let i = 0;
while (i < 100000) {
    let input = i - (i / 100) * 100;  // Pseudo-modulo
    let new_state = transition(state, input);
    if (new_state != state) {
        transitions = transitions + 1;
    }
    state = new_state;
    i = i + 1;
}
io.out.println(transitions);
