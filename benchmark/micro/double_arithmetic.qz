import system.io as io;
// @benchmark: name="Double Arithmetic" iterations=200000 category="micro"
// Tests the applyBinaryDoubleDouble fast-path

let sum = 0.0;
let i = 0;
while (i < 200000) {
    sum = sum + 1.5;
    sum = sum - 0.5;
    sum = sum * 1.1;
    sum = sum / 1.1;
    i = i + 1;
}
io.out.println(sum);
